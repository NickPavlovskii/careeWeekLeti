    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@mdi/font": "^7.4.47",
    "core-js": "^3.8.3",
    "emailjs-com": "^3.2.0",
    "sass": "^1.91.0",
    "swiper": "^12.0.3",
    "vue": "^3.2.13",
    "vue-router": "^4.6.3",
    "vue-yandex-maps": "^2.2.2",
    "vuetify": "^3.9.6"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-essentials": "^8.6.14",
